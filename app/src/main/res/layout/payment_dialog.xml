<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_background"
    tools:context=".ui.payment.RefundPaymentDialogFragment">

    <TextView
        android:id="@+id/dialogTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="16dp"
        android:text="Pagar Pedido"
        android:textColor="@color/primary_500"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textAlignment="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/closeDialog"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:padding="4dp"
        android:src="@drawable/ic_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/neutral_400" />

    <com.google.android.material.divider.MaterialDivider
        android:id="@+id/materialDivider2"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        app:dividerColor="@color/neutral_200"
        app:layout_constraintTop_toBottomOf="@+id/dialogTitle" />

    <LinearLayout
        android:id="@+id/infoSection"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="24dp"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/materialDivider2">

        <TextView
            android:id="@+id/paymentMethod"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CARTÃO DE CRÉDITO"
            android:textColor="@color/neutral_500"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textAllCaps="true"/>

        <TextView
            android:id="@+id/paymentAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="R$ 2.184,26"
            android:textColor="@color/neutral_900"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/paymentInstallments"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="em 10x de R$ 218,42"
            android:textColor="@color/primary_500"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/contentView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="32dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/infoSection">

        <LinearLayout
            android:id="@+id/loadingView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="visible">

            <ProgressBar
                android:id="@+id/progressIndicator"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:indeterminateTint="@color/primary_500" />

            <TextView
                android:id="@+id/transactionMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Aguardando maquininha..."
                android:textAlignment="center"
                android:textColor="@color/neutral_700"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Siga as instruções na tela da maquininha para concluir o pagamento."
                android:textAlignment="center"
                android:textColor="@color/neutral_500"
                android:textSize="14sp" />

        </LinearLayout>


        <LinearLayout
            android:id="@+id/errorView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:src= "@drawable/close_circle_outline" />

            <TextView
                android:id="@+id/errorMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ops, algo deu errado"
                android:textAllCaps="true"
                android:textAlignment="center"
                android:textSize="20sp"
                android:visibility="visible"
                android:layout_marginTop="12dp"/>

            <com.google.android.material.divider.MaterialDivider
                android:id="@+id/transactionDivider"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="16dp"
                app:dividerColor="@color/neutral_200"
                app:layout_constraintTop_toBottomOf="@+id/dialogTitle"
                tools:layout_editor_absoluteX="0dp" />

            <Button
                android:id="@+id/retryAction"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/default_button_background"
                android:text="Tentar novamente"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/infoSection" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/successView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

<!--            TODO ADICIONAR INFORMACOES DA TRANSACAO-->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:src= "@drawable/check_circle_outline" />

            <TextView
                android:id="@+id/successMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pagamento realizado com sucesso!"
                android:textAllCaps="true"
                android:textAlignment="center"
                android:textSize="20sp"
                android:layout_marginTop="12dp"/>

            <ImageView
                android:id="@+id/pixQrCodeImage"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:contentDescription="QR Code Pix"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/pixCopyPasteLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Codigo copia e cola"
                android:textAlignment="center"
                android:textColor="@color/neutral_700"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/pixCopyPasteValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAlignment="center"
                android:textColor="@color/neutral_500"
                android:textIsSelectable="true"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="00020101021226880014br.gov.bcb.pix2566pix.example.com/qr/v2/12345652040000530398654041.005802BR5913DETRAPAY6009SAO PAULO62070503***6304ABCD"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/pixMetaInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textAlignment="center"
                android:textColor="@color/primary_500"
                android:textSize="14sp"
                android:visibility="gone"
                tools:text="TxId: abc123\nExpira em: 2026-03-06T18:30:00"
                tools:visibility="visible" />

            <Button
                android:id="@+id/copyPixCodeBtn"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/default_button_background"
                android:text="Copiar codigo PIX"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible" />

            <Button
                android:id="@+id/backSuccessBtn"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/secondary_button_background"
                android:text="Voltar ao pedido"
                android:textAllCaps="false"
                android:textColor="@color/primary_500"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/infoSection" />

        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
