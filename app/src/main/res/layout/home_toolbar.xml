<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/primary_500"
    android:paddingLeft="16dp"
    android:paddingTop="22dp"
    android:paddingRight="16dp"
    android:paddingBottom="20dp">

    <LinearLayout
        android:id="@+id/employeeLayout"
        android:layout_width="0dp"
        android:layout_height="45dp"
        android:gravity="start|center"
        app:layout_constraintEnd_toStartOf="@+id/toolbarLogout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="UseCompoundDrawables">

        <include
            android:id="@+id/circularAvatar"
            layout="@layout/circular_avatar"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:textAlignment="center" />

        <TextView
            android:id="@+id/employeeName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Rodrigo!" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            android:contentDescription="@string/toolbar_change_store_content_description"
            android:src="@drawable/arrow_back" />
    </LinearLayout>

    <ImageView
        android:id="@+id/imageView3"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:contentDescription="@string/toolbar_change_store_content_description"
        android:src="@drawable/ic_location"
        app:layout_constraintBottom_toBottomOf="@+id/companyName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/employeeLayout" />

    <TextView
        android:id="@+id/companyName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/primary_200"
        android:textSize="12sp"
        app:layout_constraintStart_toEndOf="@+id/imageView3"
        app:layout_constraintTop_toBottomOf="@+id/employeeLayout"
        tools:text="CONSESSIONARIA MITO" />

    <ImageView
        android:id="@+id/toolbarNotifications"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginEnd="16dp"
        android:contentDescription="@string/toolbar_notifications_content_description"
        android:src="@drawable/ic_notifications"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/toolbarLogout"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/toolbarLogout"
        android:layout_width="28dp"
        android:layout_height="45dp"
        android:contentDescription="@string/toolbar_content_description"
        android:src="@drawable/ic_logout"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>