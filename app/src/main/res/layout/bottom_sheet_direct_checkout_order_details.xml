<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/neutral_100"
    android:orientation="vertical"
    android:paddingTop="10dp"
    android:paddingBottom="18dp">

    <View
        android:layout_width="84dp"
        android:layout_height="8dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/payment_method_chip_background" />

    <TextView
        android:id="@+id/orderDetailsTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="20dp"
        android:textColor="@color/neutral_900"
        android:textSize="26sp"
        android:textStyle="bold"
        tools:text="Pedido #502" />

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.DS.SurfaceCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="16dp"
        app:strokeColor="@color/primary_200"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/direct_checkout_client_label"
                android:textColor="@color/neutral_500"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/orderCustomerName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/neutral_900"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="Antonio Gerbson" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/direct_checkout_pending_amount_label"
                android:textColor="@color/neutral_500"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/orderPendingAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/red"
                android:textSize="30sp"
                android:textStyle="bold"
                tools:text="R$ 995,71" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="20dp"
        android:text="@string/direct_checkout_payment_methods_title"
        android:textColor="@color/neutral_900"
        android:textSize="16sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/paymentMethodsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        android:orientation="vertical" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancel"
        style="@style/Widget.DS.SecondaryButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:text="@string/registration_payment_picker_cancel" />
</LinearLayout>
