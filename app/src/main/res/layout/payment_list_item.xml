<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/orderCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/spacing_medium"
    android:layout_marginVertical="@dimen/spacing_small"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="@dimen/radius_medium"
    app:cardElevation="@dimen/elevation_low"
    app:rippleColor="@color/primary_100">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/spacing_medium">

        <LinearLayout
            android:id="@+id/paymentDetails"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintEnd_toStartOf="@+id/status"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/ordeId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/neutral_800"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Pedido n: 12345" />

            <TextView
                android:id="@+id/amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:textColor="@color/primary_500"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="R$ 50,00" />

            <TextView
                android:id="@+id/installments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:textColor="@color/neutral_600"
                android:textSize="13sp"
                tools:text="Parcelas: 1" />

            <TextView
                android:id="@+id/paymentMethod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:textColor="@color/neutral_600"
                android:textSize="13sp"
                tools:text="Metodo de pagamento: Crédito" />

            <TextView
                android:id="@+id/transactionId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:textColor="@color/neutral_600"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="Id de transação" />

            <TextView
                android:id="@+id/transactionCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:textColor="@color/neutral_600"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="Código da transação" />

            <TextView
                android:id="@+id/message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:textColor="@color/neutral_600"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="Detalhes" />

            <TextView
                android:id="@+id/errorCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:textColor="@color/neutral_600"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="Codigo de erro" />

            <TextView
                android:id="@+id/cardBrand"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:textColor="@color/neutral_600"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="Bandeira do cartão" />

            <TextView
                android:id="@+id/cardHolder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:textColor="@color/neutral_600"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="Titular do cartão" />

            <TextView
                android:id="@+id/cardLast4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:textColor="@color/neutral_600"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="Últimos digitos do cartão" />

            <TextView
                android:id="@+id/pixIdentification"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:textColor="@color/neutral_600"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="Identificação do pix" />

        </LinearLayout>

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/spacing_small"
            android:paddingVertical="@dimen/spacing_xs"
            android:textAllCaps="true"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:background="@drawable/pending_status_background"
            tools:text="Pendente" />

        <TextView
            android:id="@+id/paymentDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:textColor="@color/neutral_400"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/paymentDetails"
            tools:text="02/02/2025" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>