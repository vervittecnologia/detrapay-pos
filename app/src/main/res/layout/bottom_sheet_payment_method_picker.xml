<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/neutral_100"
    android:orientation="vertical"
    android:paddingTop="10dp"
    android:paddingBottom="16dp">

    <View
        android:layout_width="84dp"
        android:layout_height="8dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/payment_method_chip_background" />

    <TextView
        android:id="@+id/paymentPickerTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="24dp"
        android:text="@string/registration_payment_picker_title"
        android:textColor="@color/neutral_900"
        android:textSize="32sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/paymentPickerSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="24dp"
        android:text="@string/registration_payment_picker_subtitle"
        android:textColor="@color/neutral_600"
        android:textSize="14sp" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/optionCredit"
        style="@style/Widget.DS.SurfaceCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="16dp"
        app:strokeColor="@color/neutral_300"
        app:strokeWidth="1dp">

        <include layout="@layout/view_payment_method_credit_row" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/optionDebit"
        style="@style/Widget.DS.SurfaceCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        app:strokeColor="@color/neutral_300"
        app:strokeWidth="1dp">

        <include layout="@layout/view_payment_method_debit_row" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/optionPix"
        style="@style/Widget.DS.SurfaceCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        app:strokeColor="@color/neutral_300"
        app:strokeWidth="1dp">

        <include layout="@layout/view_payment_method_pix_row" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/optionCash"
        style="@style/Widget.DS.SurfaceCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        app:strokeColor="@color/neutral_300"
        app:strokeWidth="1dp">

        <include layout="@layout/view_payment_method_cash_row" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/optionStoreCredit"
        style="@style/Widget.DS.SurfaceCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        app:strokeColor="@color/neutral_300"
        app:strokeWidth="1dp">

        <include layout="@layout/view_payment_method_store_credit_row" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancel"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="16dp"
        android:backgroundTint="@color/neutral_200"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/registration_payment_picker_cancel"
        android:textAllCaps="false"
        android:textColor="@color/neutral_800"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="14dp" />

</LinearLayout>
