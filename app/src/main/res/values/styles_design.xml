<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DS.Base" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/ds_primary</item>
        <item name="colorPrimaryVariant">@color/ds_primary_variant</item>
        <item name="colorOnPrimary">@color/ds_on_primary</item>
        <item name="colorSecondary">@color/ds_secondary</item>
        <item name="android:statusBarColor">@color/ds_primary_variant</item>
    </style>

    <style name="Widget.DS.Toolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="android:layout_height">@dimen/ds_toolbar_height</item>
        <item name="titleTextAppearance">@style/TextAppearance.DS.Toolbar.Title</item>
    </style>

    <style name="Widget.DS.IconButton" parent="">
        <item name="android:layout_width">@dimen/ds_touch_target</item>
        <item name="android:layout_height">@dimen/ds_touch_target</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:padding">@dimen/ds_spacing_sm</item>
    </style>

    <style name="Widget.DS.PrimaryButton" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/ds_text_body</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">@dimen/ds_radius_md</item>
        <item name="backgroundTint">@color/ds_primary</item>
    </style>

    <style name="Widget.DS.SecondaryButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">56dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/ds_text_body</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">@dimen/ds_radius_md</item>
        <item name="strokeColor">@color/ds_border</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.DS.SurfaceCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/ds_surface</item>
        <item name="cardCornerRadius">@dimen/ds_radius_lg</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/ds_border</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="TextAppearance.DS.Toolbar.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/ds_on_primary</item>
    </style>

    <style name="TextAppearance.DS.ScreenTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/ds_on_background</item>
        <item name="android:textSize">@dimen/ds_text_title</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.DS.SectionTitle" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textColor">@color/ds_on_background</item>
        <item name="android:textSize">@dimen/ds_text_subtitle</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.DS.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/ds_on_surface</item>
        <item name="android:textSize">@dimen/ds_text_body</item>
    </style>

    <style name="TextAppearance.DS.Label" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textColor">@color/neutral_500</item>
        <item name="android:textSize">@dimen/ds_text_label</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
