<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Detrapay" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">@color/color_primary</item>
        <item name="android:fontFamily">@font/font</item>
        <item name="android:statusBarColor">@color/color_primary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowActivityTransitions">false</item>
    </style>

    <style name="Theme.Detrapay.NoActionBar" parent="Theme.Detrapay">
        <item name="android:colorAccent">@color/primary_800</item>
    </style>

    <style name="Theme.Detrapay.Login" parent="Theme.Detrapay">
        <item name="android:colorAccent">@color/primary_800</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/primary_100</item>
    </style>

    <style name="Theme.Detrapay.Splash" parent="Theme.Detrapay">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:colorAccent">@color/white</item>
        <item name="android:statusBarColor">@color/splash_blue</item>
        <item name="android:windowActivityTransitions">false</item>
    </style>
</resources>
